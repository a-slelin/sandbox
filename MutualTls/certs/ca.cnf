# ---------------------------------------------------------------------------
#  Корневой удостоверяющий центр (CA).
#  Им подписываются сертификаты сервера и клиента; обе стороны доверяют
#  только ему, поэтому «чужой» сертификат не пройдёт проверку.
# ---------------------------------------------------------------------------

[ req ]
prompt             = no            # не задавать вопросов, всё берётся из [ dn ]
utf8               = yes           # значения полей — в UTF-8 (нужно для кириллицы)
string_mask        = utf8only      # кодировать поля как UTF8String
default_md         = sha256        # алгоритм хеширования подписи
distinguished_name = dn
x509_extensions    = ca_ext        # расширения самоподписанного сертификата CA

[ dn ]
C  = RU
L  = Ярославль
O  = ЯрГУ им. П. Г. Демидова
OU = ПМИ-21МО
CN = Слелин А. В. Root CA

[ ca_ext ]
basicConstraints       = critical, CA:TRUE, pathlen:0   # это CA, подчинённых CA быть не может
keyUsage               = critical, keyCertSign, cRLSign # может только подписывать сертификаты и CRL
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
